# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# --- Database (Neon) ---
# Neon dashboard -> your project -> Connection string (use the "pooled" one)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth (Clerk) ---
# Clerk dashboard -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# --- File storage (Cloudflare R2) ---
# Cloudflare dashboard -> R2 -> Manage API tokens
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="dealer-post-photos"
# Public bucket URL (R2 public development URL, or a custom domain you attach)
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
